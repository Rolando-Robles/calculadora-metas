rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Correo verificado del token en minúsculas. Los perfiles viven en users/{correo}.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function hasVerifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function userDoc(id) {
      return /databases/$(database)/documents/users/$(id);
    }

    // Admin por su perfil actual (users/{correo}) o por el perfil de formato
    // anterior (users/{uid}) mientras no se consolide.
    function isAdmin() {
      return signedIn() && (
        (hasVerifiedEmail() && exists(userDoc(myEmail())) && get(userDoc(myEmail())).data.role == 'admin') ||
        (exists(userDoc(request.auth.uid)) && get(userDoc(request.auth.uid)).data.role == 'admin')
      );
    }

    function periodLocked(period) {
      return exists(/databases/$(database)/documents/periods/$(period)) &&
             get(/databases/$(database)/documents/periods/$(period)).data.locked == true;
    }

    // Users collection
    match /users/{userId} {
      function isOwnDoc() {
        return userId == request.auth.uid || (hasVerifiedEmail() && userId == myEmail());
      }

      // Perfil propio: actual (por correo), del uid, o el alias del CSV anterior con su correo.
      allow get: if signedIn() && (
        isOwnDoc() ||
        (hasVerifiedEmail() && resource.data.get('email', '').lower() == myEmail())
      );

      // Primer inicio de sesión: solo un perfil de vendedor con su propio correo y uid.
      // Categoría, producto y rol solo los asigna un admin.
      allow create: if hasVerifiedEmail() &&
        userId == myEmail() &&
        myEmail().matches('.*@avivacredito[.]com$') &&
        request.resource.data.email == myEmail() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == 'vendedor' &&
        request.resource.data.keys().hasOnly(['email', 'uid', 'name', 'role', 'status', 'createdAt', 'updatedAt', 'lastLoginAt']);

      // El propio usuario solo puede actualizar datos de sesión; nunca su rol, categoría o producto.
      allow update: if signedIn() && isOwnDoc() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'name', 'lastLoginAt', 'updatedAt']) &&
        request.resource.data.get('uid', request.auth.uid) == request.auth.uid;

      // Admins can read and manage all users
      allow read, write: if isAdmin();
    }

    // User Goals collection
    match /userGoals/{goalId} {
      // Users can read their own goals (userEmail en minúsculas)
      allow read: if hasVerifiedEmail() && resource.data.userEmail == myEmail();

      allow read: if isAdmin();

      // Admins can write goals of periods that are not closed
      allow create, update: if isAdmin() && !periodLocked(request.resource.data.period);
      allow delete: if isAdmin() && !periodLocked(resource.data.period);
    }

    // Cierre de periodos (YYYY-MM)
    match /periods/{period} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Historial de importaciones (con el "antes" para poder revertir)
    match /imports/{importId} {
      allow read, write: if isAdmin();

      match /chunks/{chunkId} {
        allow read, write: if isAdmin();
      }
    }

    // Config collection (incentives config)
    match /config/{docId} {
      // Anyone authenticated can read
      allow read: if signedIn();

      // Only admins can write
      allow write: if isAdmin();
    }
  }
}
